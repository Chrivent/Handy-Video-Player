<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="HandyPlayer.uss" />
    <ui:VisualElement name="handy-player">
        <ui:VisualElement name="workspace">
            <ui:Label name="player-heading" text="핸디 영상 플레이어" class="title" />
            <ui:VisualElement name="panes">
                <ui:VisualElement name="sidebar" class="panel">
                    <ui:VisualElement class="tabs">
                        <ui:Button name="library-tab" text="영상 목록" class="button tab" />
                        <ui:Button name="settings-tab" text="기기 연결" class="button tab" />
                    </ui:VisualElement>
                    <ui:VisualElement name="library-panel">
                        <ui:VisualElement class="folder-row">
                            <ui:TextField name="media-folder" label="영상 폴더" class="entry" />
                            <ui:Button name="media-refresh" text="새로고침" class="button" />
                        </ui:VisualElement>
                        <ui:TextField name="media-filter" label="영상 검색" class="entry" />
                        <ui:Label name="media-count" class="metric" />
                        <ui:ListView name="media-list" selection-type="None" fixed-item-height="142" />
                    </ui:VisualElement>
                    <ui:ScrollView name="settings-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden">
                        <ui:RadioButtonGroup name="transport" label="연결 방식" choices="Wi-Fi 연결,블루투스 직접 연결" class="entry routes" />
                        <ui:VisualElement name="credentials">
                            <ui:TextField name="connection-key" label="Connection Key" password="false" class="entry" />
                        </ui:VisualElement>
                        <ui:VisualElement name="bluetooth" style="display: none;">
                            <ui:Button name="scan" text="기기 검색" class="button check" />
                            <ui:RadioButtonGroup name="devices" label="내 핸디 선택" class="entry" />
                        </ui:VisualElement>
                        <ui:Button name="check" text="연결 확인" class="button check" />
                        <ui:Label name="latency" class="metric" />
                        <ui:Label name="profile" class="profile" />
                        <ui:Button name="start" text="2초 테스트 시작" class="button check" />
                    </ui:ScrollView>
                </ui:VisualElement>
                <ui:VisualElement name="viewer" class="panel">
                    <ui:VisualElement class="viewer-heading">
                        <ui:Label name="media-selected" enable-rich-text="false" class="film-name" />
                        <ui:Button name="media-expand" text="크게 보기" class="button" />
                    </ui:VisualElement>
                    <ui:VisualElement name="media-stage">
                        <ui:Image name="media-picture" picking-mode="Ignore" />
                        <ui:Label name="media-empty" text="목록에서 썸네일을 선택하세요." picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label name="media-time" class="metric" />
                    <ui:Slider name="media-seek" label="재생 위치" low-value="0" high-value="1" />
                    <ui:Label name="media-status" enable-rich-text="false" class="detail" />
                    <ui:VisualElement class="actions">
                        <ui:Button name="media-play" text="영상과 핸디 재생" class="button start" />
                        <ui:Button name="media-pause" text="일시정지" class="button media-action" />
                        <ui:Button name="media-first" text="첫 동작으로" class="button media-action" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="device-bar">
                <ui:Label name="state" text="연결 대기" class="state" />
                <ui:Label name="detail" enable-rich-text="false" class="detail" />
                <ui:Button name="stop" text="정지" class="button stop" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
