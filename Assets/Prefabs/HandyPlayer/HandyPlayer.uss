#handy-player {
    position: absolute;
    top: 0; bottom: 0; left: 0; right: 0;
    background-color: rgb(19, 33, 38);
    color: rgb(224, 237, 235);
    -unity-font-definition: url("../../Fonts/NotoSansKR.ttf");
}
#workspace { flex-grow: 1; min-height: 0; padding: 12px 18px; }
.title { font-size: 30px; -unity-font-style: bold; margin: 0 0 8px 0; }
#panes { flex-direction: row; flex-grow: 1; flex-basis: 0; min-height: 0; }
.panel { min-width: 0; min-height: 0; border-radius: 8px; background-color: rgb(33, 51, 58); padding: 12px; }
#sidebar { width: 37%; max-width: 590px; margin-right: 12px; }
#viewer { flex-grow: 1; flex-basis: 0; }
.tabs, .folder-row, .viewer-heading, .actions, #device-bar { flex-direction: row; align-items: center; flex-shrink: 0; }
.tabs { margin-bottom: 6px; }
.button {
    min-height: 38px;
    margin: 0;
    padding: 2px 12px;
    border-width: 1px;
    border-color: rgb(94, 129, 130);
    border-radius: 5px;
    background-color: rgb(46, 72, 79);
    background-image: none;
    color: rgb(232, 244, 241);
    font-size: 16px;
    -unity-font-style: bold;
}
.button:hover, .button:focus { border-color: rgb(218, 245, 234); }
.button:disabled { opacity: 0.44; }
.tab { flex-basis: 0; flex-grow: 1; margin-right: 3px; }
#workspace #library-tab, #workspace.settings-open #settings-tab { background-color: rgb(133, 220, 194); color: rgb(15, 42, 39); }
#workspace.settings-open #library-tab { background-color: rgb(46, 72, 79); color: rgb(232, 244, 241); }
#settings-scroll, #library-panel, #media-list { flex-grow: 1; flex-basis: 0; min-height: 0; }
#settings-scroll, #workspace.settings-open #library-panel { display: none; }
#workspace.settings-open #settings-scroll { display: flex; }
.entry { flex-direction: column; align-items: stretch; margin: 5px 0 0 0; flex-shrink: 0; }
.entry .unity-base-field__label { color: rgb(184, 205, 205); font-size: 15px; margin-bottom: 2px; }
.entry .unity-radio-button { margin: 3px 10px 3px 0; min-height: 30px; }
.entry .unity-radio-button__text { color: rgb(232, 244, 241); font-size: 16px; white-space: normal; }
.routes .unity-radio-button-group__container { flex-direction: row; flex-wrap: wrap; }
.entry .unity-base-text-field__input {
    min-height: 32px; min-width: 0; padding: 2px 8px; border-radius: 4px;
    background-color: rgb(19, 33, 38); color: rgb(238, 247, 243); font-size: 16px;
}
#media-folder { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; }
#media-refresh { flex-shrink: 0; min-height: 32px; margin-left: 6px; align-self: flex-end; }
.metric, .profile { color: rgb(178, 202, 200); font-size: 14px; white-space: normal; margin-top: 4px; flex-shrink: 0; }
.profile { margin-top: 16px; }
.check { margin-top: 8px; align-self: flex-start; }
#media-list { margin-top: 6px; }
.gallery-row { flex-direction: row; height: 100%; }
.gallery-tile {
    flex-grow: 1; flex-basis: 0; min-width: 0; margin: 2px; padding: 2px;
    border-width: 2px; border-radius: 5px; border-color: rgb(56, 77, 82);
    background-color: rgb(23, 39, 43); background-image: none; overflow: hidden;
    align-items: stretch; justify-content: flex-start;
}
.gallery-tile:hover, .gallery-tile:focus { border-color: rgb(155, 184, 181); }
.gallery-tile.selected { border-color: rgb(133, 220, 194); background-color: rgb(48, 75, 74); }
.tile-frame { flex-grow: 1; flex-basis: 0; min-height: 0; align-items: center; justify-content: center; background-color: rgb(13, 23, 26); overflow: hidden; }
/* 디코더가 위쪽 행부터 채운 텍스처를 화면 방향에 맞춘다. */
.tile-image, #media-picture { position: absolute; top: 0; bottom: 0; left: 0; right: 0; scale: 1 -1; }
.tile-caption, .film-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tile-caption { height: 24px; margin: 0; padding: 1px 4px; font-size: 14px; color: rgb(231, 241, 238); -unity-text-align: middle-left; }
.tile-missing { position: absolute; top: 3px; left: 3px; color: rgb(255, 228, 206); background-color: rgba(65, 39, 30, 0.94); border-radius: 3px; padding: 1px 5px; font-size: 12px; }
.tile-unavailable, #media-empty { color: rgb(172, 192, 193); white-space: normal; -unity-text-align: middle-center; }
.viewer-heading { margin-bottom: 7px; }
.film-name { flex-grow: 1; flex-basis: 0; margin-right: 8px; font-size: 18px; -unity-font-style: bold; }
#media-stage { flex-grow: 1; flex-basis: 0; min-height: 0; align-items: center; justify-content: center; background-color: rgb(8, 14, 17); overflow: hidden; }
#media-seek { flex-shrink: 0; margin: 3px 0; }
#media-seek .unity-base-field__label { color: rgb(184, 205, 205); min-width: 70px; }
.detail { color: rgb(224, 237, 235); font-size: 15px; white-space: normal; }
.actions { margin-top: 6px; }
.start { flex-grow: 2; flex-basis: 0; min-width: 0; background-color: rgb(133, 220, 194); color: rgb(15, 42, 39); }
.media-action { flex-grow: 1; flex-basis: 0; min-width: 0; margin-left: 6px; }
#device-bar { margin-top: 9px; padding-top: 7px; border-top-width: 1px; border-top-color: rgb(67, 88, 94); }
.state { flex-shrink: 0; color: rgb(134, 225, 200); -unity-font-style: bold; font-size: 20px; }
.state.warning { color: rgb(255, 181, 136); }
#detail { flex-grow: 1; flex-basis: 0; margin: 0 12px; }
.stop { min-width: 88px; background-color: rgb(114, 57, 43); color: rgb(255, 233, 218); }
#workspace.stacked #panes { flex-direction: column; }
#workspace.stacked #sidebar { width: 100%; max-width: none; height: 45%; margin: 0 0 8px 0; }
#workspace.expanded #sidebar, #workspace.expanded #player-heading { display: none; }
